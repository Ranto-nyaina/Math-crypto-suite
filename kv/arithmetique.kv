#:import dp kivy.metrics.dp

<ArithmetiqueScreen>:
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Arithmétique"
            elevation: 8
            md_bg_color: app.theme_cls.primary_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_back()]]

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Entrez vos nombres"
                    font_style: "H6"
                    bold: True
                    adaptive_height: True

                MDTextField:
                    id: nombres_field
                    hint_text: "Ex : 12, 15, 7, 21"
                    mode: "rectangle"

                MDRaisedButton:
                    text: "CALCULER"
                    pos_hint: {"center_x": .5}
                    on_release: root.calculer()

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(8)
                    radius: [dp(16)]
                    elevation: 2
                    md_bg_color: app.theme_cls.bg_normal
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "NOMBRES PREMIERS TRIÉS"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        id: premiers_label
                        text: "—"
                        font_style: "H6"
                        theme_text_color: "Primary"
                        adaptive_height: True

                    MDLabel:
                        id: pgcd_label
                        text: "PGCD = —"
                        font_style: "H6"
                        adaptive_height: True

                    MDLabel:
                        id: ppcm_label
                        text: "PPCM = —"
                        font_style: "H6"
                        adaptive_height: True