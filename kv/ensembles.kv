#:import dp kivy.metrics.dp

<EnsemblesScreen>:
    MDBoxLayout:
        orientation: "vertical"

        MDToolbar:
            title: "Ensembles"
            elevation: 8
            md_bg_color: app.theme_cls.primary_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_back()]]

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                MDTextField:
                    id: ens_a
                    hint_text: "Ensemble A — ex : 1,2,3,5"
                    mode: "rectangle"

                MDTextField:
                    id: ens_b
                    hint_text: "Ensemble B — ex : 10,11,13,16"
                    mode: "rectangle"

                MDRaisedButton:
                    text: "CALCULER"
                    pos_hint: {"center_x": .5}
                    on_release: root.calculer()

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(8)
                    radius: [dp(16)]
                    elevation: 2
                    md_bg_color: app.theme_cls.bg_normal
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "UNION A ∪ B"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        id: union_label
                        text: "—"
                        font_style: "H6"
                        theme_text_color: "Primary"
                        adaptive_height: True

                    MDLabel:
                        text: "INTERSECTION A ∩ B"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        id: inter_label
                        text: "—"
                        font_style: "H6"
                        adaptive_height: True

                    MDLabel:
                        text: "DIFFÉRENCE A \\ B"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        id: diff_label
                        text: "—"
                        font_style: "H6"
                        adaptive_height: True

                    MDLabel:
                        id: card_label
                        text: "—"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        text: "IMAGE DE A PAR f(x) = x² − 3"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                    MDLabel:
                        id: image_label
                        text: "—"
                        font_style: "H6"
                        adaptive_height: True